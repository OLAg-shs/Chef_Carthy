{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 6,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": [
        "custom/logo",
        "custom/terminal",
        "custom/launcher",
        "custom/files",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "cpu",
        "memory",
        "custom/power"
    ],
    "custom/logo": {
        "format": "🛡️ Chef OS",
        "tooltip-format": "Chef_Carthy OS Dashboard (Click to open menu)",
        "on-click": "alacritty -t 'Chef Control Center' -e chef menu"
    },
    "custom/terminal": {
        "format": " Term",
        "tooltip-format": "Terminal (SUPER+Return / SUPER+O / SUPER+T)",
        "on-click": "alacritty || kitty || foot"
    },
    "custom/launcher": {
        "format": " Apps",
        "tooltip-format": "App Launcher (SUPER+Space)",
        "on-click": "pkill wofi || wofi --show drun"
    },
    "custom/files": {
        "format": " Files",
        "tooltip-format": "File Manager (SUPER+E)",
        "on-click": "thunar || alacritty -e yazi"
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },
    "clock": {
        "format": "  {:%a, %b %d  •  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "🔇 Muted",
        "format-icons": {
            "default": ["🔈", "🔉", "🔊"]
        },
        "on-click": "pavucontrol || alacritty"
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 2
    },
    "memory": {
        "format": " {percentage}%",
        "interval": 2
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power Menu / Shutdown",
        "on-click": "wlogout || alacritty -e bash -c 'read -p \"Press Enter to shut down...\" && sudo poweroff'"
    }
}
