{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": [
        "custom/logo",
        "custom/terminal",
        "custom/launcher",
        "custom/files",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "custom/chef_status"
    ],
    "modules-right": [
        "pulseaudio",
        "cpu",
        "memory",
        "clock",
        "custom/power"
    ],
    "custom/logo": {
        "format": "🛡️ CHEF OS",
        "tooltip-format": "Chef_Carthy OS Control Center (Click to open)",
        "on-click": "alacritty -t 'Chef Control Center' -e chef menu"
    },
    "custom/terminal": {
        "format": " Terminal",
        "tooltip-format": "Launch Terminal (SUPER+Return / SUPER+O / SUPER+T)",
        "on-click": "alacritty || kitty || foot"
    },
    "custom/launcher": {
        "format": " Apps",
        "tooltip-format": "Launch App Menu (SUPER+Space)",
        "on-click": "pkill wofi || wofi --show drun"
    },
    "custom/files": {
        "format": " Files",
        "tooltip-format": "Open File Manager (SUPER+E)",
        "on-click": "thunar || alacritty -e yazi"
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },
    "custom/chef_status": {
        "format": "⚡ CYBER & AGENTIC AI CORE",
        "tooltip": false,
        "on-click": "chef-gui"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "🔇 Muted",
        "format-icons": {
            "default": ["🔈", "🔉", "🔊"]
        },
        "on-click": "pavucontrol || alacritty"
    },
    "cpu": {
        "format": "⚡ {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "🧠 {percentage}%",
        "interval": 2
    },
    "clock": {
        "format": "🕒 {:%a %b %d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout || alacritty -e bash -c 'read -p \"Press Enter to shut down...\" && sudo poweroff'"
    }
}
