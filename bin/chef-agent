#!/usr/bin/env python3
"""
Chef_Carthy OS - Unrestricted Autonomous AI Operating System Controller (chef-agent)
Gives Google Gemini & Antigravity AI full, unrestricted visibility and tool execution
across the entire Arch Linux / Hyprland OS.
"""

import sys
import os
import re
import json
import time
import shutil
import glob
import subprocess
import urllib.request
import urllib.error
from pathlib import Path

# ANSI Styling
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_RED = "\033[38;5;196m"
C_GREEN = "\033[38;5;46m"
C_CYAN = "\033[38;5;51m"
C_YELLOW = "\033[38;5;226m"
C_PURPLE = "\033[38;5;141m"
C_GRAY = "\033[38;5;244m"

CONFIG_DIR = Path.home() / ".config" / "chef_carthy"
KEY_FILE = CONFIG_DIR / "ai_credentials.json"

SYSTEM_PROMPT = """You are the Chef_Carthy OS Autonomous AI System Controller.
You are granted UNRESTRICTED, FULL-SYSTEM ACCESS across the user's Arch Linux operating system.

Your Capabilities:
1. Shell Execution: Run any bash/shell commands, install software, manage systemd services, configure firewalls, and compile binaries.
2. File Operations: Read, write, modify, and search any file or configuration across the filesystem (/etc, ~/.config, /var/log, /usr, /home).
3. Cybersecurity & Penetration Testing: Perform live reconnaissance, port scanning, web application audits, vulnerability identification, and host defense.
4. Desktop & System Customization: Configure Hyprland, Waybar, themes, wallpapers, audio, and performance settings.

Guidelines:
- Solve the user's problem end-to-end using your available tools.
- When running multi-step tasks, execute all necessary actions consecutively until the objective is 100% complete.
- Be precise, fast, and proactive.
"""

class ChefAIEngine:
    def __init__(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        self.api_key = self._load_api_key()

    def _load_api_key(self):
        env_key = os.getenv("GEMINI_API_KEY") or os.getenv("GOOGLE_API_KEY")
        if env_key:
            return env_key
        if KEY_FILE.exists():
            try:
                with open(KEY_FILE, "r") as f:
                    data = json.load(f)
                    return data.get("api_key")
            except Exception:
                pass
        return None

    def save_api_key(self, key):
        self.api_key = key.strip()
        with open(KEY_FILE, "w") as f:
            json.dump({"api_key": self.api_key}, f, indent=2)
        print(f"\n{C_GREEN}{C_BOLD}✓ Google AI / Gemini credentials saved to ~/.config/chef_carthy/ai_credentials.json{C_RESET}")

    def prompt_login_if_needed(self):
        """Asks user to logon to Google CLI / Gemini if credentials are not configured."""
        if self.api_key:
            return True

        print(f"\n{C_PURPLE}{C_BOLD}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
        print(f"{C_CYAN}{C_BOLD}🔑 CHEF_CARTHY OS — GOOGLE AI & GEMINI CLI AUTHENTICATION{C_RESET}")
        print(f"{C_PURPLE}═══════════════════════════════════════════════════════════════════════════════{C_RESET}\n")
        print(f"  {C_GRAY}To give the AI real-time autonomous control across your OS, please authenticate.{C_RESET}")
        print(f"  {C_GRAY}You can get a free Google Gemini API key at: {C_BOLD}https://aistudio.google.com/{C_RESET}\n")
        print(f"  {C_CYAN}[1]{C_RESET} Enter Google Gemini API Key")
        print(f"  {C_CYAN}[2]{C_RESET} Launch Google Gemini CLI session directly")
        print(f"  {C_CYAN}[3]{C_RESET} Continue with Built-in Local Autonomous Fallback\n")

        try:
            choice = input(f"{C_BOLD}Select authentication option (1-3): {C_RESET}").strip()
            if choice == "1":
                key = input(f"{C_CYAN}{C_BOLD}Enter your Google Gemini API Key: {C_RESET}").strip()
                if key:
                    self.save_api_key(key)
                    return True
            elif choice == "2":
                if shutil.which("gemini"):
                    print(f"\n{C_GREEN}Launching Google Gemini CLI...{C_RESET}\n")
                    subprocess.run(["gemini", "-y"])
                    return True
                else:
                    print(f"{C_YELLOW}Gemini CLI binary not found in PATH.{C_RESET}")
            elif choice == "3":
                print(f"{C_GRAY}Using local autonomous fallback.{C_RESET}")
                return False
        except (KeyboardInterrupt, EOFError):
            print("\nSkipping authentication.")
        return False

    # --- Tool Call Definitions ---

    def execute_bash(self, command: str) -> dict:
        print(f"  {C_PURPLE}⚡ [AI EXEC]{C_RESET} {C_BOLD}{command}{C_RESET}")
        try:
            res = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=120)
            stdout = res.stdout.strip()
            stderr = res.stderr.strip()
            if stdout:
                lines = stdout.split("\n")
                preview = "\n".join(lines[:10]) + (f"\n... ({len(lines)-10} more lines)" if len(lines) > 10 else "")
                print(f"     {C_GRAY}↳ {preview}{C_RESET}")
            return {"stdout": stdout, "stderr": stderr, "exit_code": res.returncode}
        except Exception as e:
            print(f"     {C_RED}↳ Error: {e}{C_RESET}")
            return {"error": str(e)}

    def read_file(self, path: str) -> dict:
        p = Path(path).expanduser()
        print(f"  {C_PURPLE}📖 [AI READ]{C_RESET} {C_BOLD}{p}{C_RESET}")
        if not p.exists():
            return {"error": f"File {p} does not exist"}
        try:
            with open(p, "r", encoding="utf-8", errors="replace") as f:
                content = f.read()
            return {"content": content, "size_bytes": len(content)}
        except Exception as e:
            return {"error": str(e)}

    def write_file(self, path: str, content: str) -> dict:
        p = Path(path).expanduser()
        print(f"  {C_PURPLE}✍️  [AI WRITE]{C_RESET} {C_BOLD}{p}{C_RESET}")
        try:
            p.parent.mkdir(parents=True, exist_ok=True)
            with open(p, "w", encoding="utf-8") as f:
                f.write(content)
            return {"status": "success", "bytes_written": len(content)}
        except Exception as e:
            return {"error": str(e)}

    def search_files(self, path: str, pattern: str) -> dict:
        p = Path(path).expanduser()
        print(f"  {C_PURPLE}🔍 [AI SEARCH]{C_RESET} {C_BOLD}{p} matching '{pattern}'{C_RESET}")
        try:
            matches = list(p.rglob(pattern))[:50]
            return {"matches": [str(m) for m in matches], "count": len(matches)}
        except Exception as e:
            return {"error": str(e)}

    def install_packages(self, packages: list) -> dict:
        print(f"  {C_PURPLE}📦 [AI INSTALL]{C_RESET} {C_BOLD}{', '.join(packages)}{C_RESET}")
        aur = "yay" if shutil.which("yay") else "paru" if shutil.which("paru") else None
        cmd = [aur, "-S", "--needed", "--noconfirm"] + packages if aur else ["sudo", "pacman", "-S", "--needed", "--noconfirm"] + packages
        try:
            res = subprocess.run(cmd, capture_output=True, text=True)
            return {"exit_code": res.returncode, "stdout": res.stdout, "stderr": res.stderr}
        except Exception as e:
            return {"error": str(e)}

    def get_system_telemetry(self) -> dict:
        print(f"  {C_PURPLE}📊 [AI TELEMETRY]{C_RESET} Inspecting OS health & sockets")
        info = {
            "kernel": subprocess.check_output(["uname", "-r"], text=True).strip(),
            "uptime": subprocess.check_output(["uptime", "-p"], text=True).strip() if shutil.which("uptime") else "Active",
            "memory": subprocess.check_output(["free", "-h"], text=True).strip() if shutil.which("free") else "",
            "disk": subprocess.check_output(["df", "-h", "/"], text=True).strip() if shutil.which("df") else ""
        }
        return info

    def call_gemini(self, user_prompt: str):
        if not self.api_key:
            if not self.prompt_login_if_needed():
                return self._local_fallback(user_prompt)

        url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={self.api_key}"
        
        tools_def = [
            {
                "function_declarations": [
                    {
                        "name": "execute_bash",
                        "description": "Execute any shell or bash command with root/system access on Arch Linux.",
                        "parameters": {
                            "type": "OBJECT",
                            "properties": {
                                "command": {"type": "STRING", "description": "The shell command line to run."}
                            },
                            "required": ["command"]
                        }
                    },
                    {
                        "name": "read_file",
                        "description": "Read the contents of any file on the OS filesystem.",
                        "parameters": {
                            "type": "OBJECT",
                            "properties": {
                                "path": {"type": "STRING", "description": "Absolute or relative file path."}
                            },
                            "required": ["path"]
                        }
                    },
                    {
                        "name": "write_file",
                        "description": "Write or create any file or configuration anywhere on the system.",
                        "parameters": {
                            "type": "OBJECT",
                            "properties": {
                                "path": {"type": "STRING", "description": "Target file path."},
                                "content": {"type": "STRING", "description": "Exact text contents to write."}
                            },
                            "required": ["path", "content"]
                        }
                    },
                    {
                        "name": "search_files",
                        "description": "Search for files across a directory using glob patterns.",
                        "parameters": {
                            "type": "OBJECT",
                            "properties": {
                                "path": {"type": "STRING", "description": "Base directory to search in."},
                                "pattern": {"type": "STRING", "description": "Glob pattern e.g. '*.conf'"}
                            },
                            "required": ["path", "pattern"]
                        }
                    },
                    {
                        "name": "install_packages",
                        "description": "Install packages via pacman, yay (AUR), or BlackArch.",
                        "parameters": {
                            "type": "OBJECT",
                            "properties": {
                                "packages": {"type": "ARRAY", "items": {"type": "STRING"}, "description": "List of package names."}
                            },
                            "required": ["packages"]
                        }
                    },
                    {
                        "name": "get_system_telemetry",
                        "description": "Get current CPU, RAM, disk, kernel, and process status.",
                        "parameters": {"type": "OBJECT", "properties": {}}
                    }
                ]
            }
        ]

        contents = [{"role": "user", "parts": [{"text": f"{SYSTEM_PROMPT}\n\nTask: {user_prompt}"}]}]
        
        for step in range(12):
            payload = {
                "contents": contents,
                "tools": tools_def
            }
            
            req = urllib.request.Request(
                url,
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json"}
            )
            
            try:
                with urllib.request.urlopen(req, timeout=45) as resp:
                    res_data = json.loads(resp.read().decode("utf-8"))
                    candidates = res_data.get("candidates", [])
                    if not candidates:
                        break
                    
                    candidate = candidates[0]
                    parts = candidate.get("content", {}).get("parts", [])
                    
                    tool_calls = [p.get("functionCall") for p in parts if "functionCall" in p]
                    text_parts = [p.get("text") for p in parts if "text" in p]

                    if text_parts:
                        for t in text_parts:
                            print(f"\n{C_CYAN}{C_BOLD}🤖 Chef AI:{C_RESET} {t}")

                    if not tool_calls:
                        break

                    for tc in tool_calls:
                        fn_name = tc.get("name")
                        fn_args = tc.get("args", {})
                        
                        tool_result = {}
                        if fn_name == "execute_bash":
                            tool_result = self.execute_bash(fn_args.get("command", ""))
                        elif fn_name == "read_file":
                            tool_result = self.read_file(fn_args.get("path", ""))
                        elif fn_name == "write_file":
                            tool_result = self.write_file(fn_args.get("path", ""), fn_args.get("content", ""))
                        elif fn_name == "search_files":
                            tool_result = self.search_files(fn_args.get("path", "."), fn_args.get("pattern", "*"))
                        elif fn_name == "install_packages":
                            tool_result = self.install_packages(fn_args.get("packages", []))
                        elif fn_name == "get_system_telemetry":
                            tool_result = self.get_system_telemetry()

                        contents.append({
                            "role": "model",
                            "parts": [{"functionCall": tc}]
                        })
                        contents.append({
                            "role": "function",
                            "parts": [{
                                "functionResponse": {
                                    "name": fn_name,
                                    "response": tool_result
                                }
                            }]
                        })
            except urllib.error.HTTPError as e:
                err_msg = e.read().decode("utf-8")
                print(f"{C_RED}Google API Error ({e.code}): {err_msg}{C_RESET}")
                break
            except Exception as e:
                print(f"{C_RED}Execution Error: {e}{C_RESET}")
                break

    def _local_fallback(self, prompt: str):
        p_lower = prompt.lower().strip()
        print(f"\n{C_PURPLE}⚡ [CHEF AUTONOMOUS LOCAL ENGINE]{C_RESET}")
        
        if "scan" in p_lower:
            words = prompt.split()
            target = words[-1] if len(words) > 1 else "127.0.0.1"
            if target.startswith("http://") or target.startswith("https://"):
                subprocess.run(["chef", "web", target])
            else:
                subprocess.run(["chef", "scan", target])
        elif "wallpaper" in p_lower or "background" in p_lower:
            subprocess.run(["chef-wallpaper", "next"])
        elif "theme" in p_lower:
            subprocess.run(["chef-theme", "list"])
        elif "firewall" in p_lower or "ufw" in p_lower:
            self.execute_bash("sudo ufw status verbose")
        elif "socket" in p_lower or "port" in p_lower:
            self.execute_bash("ss -tulpn")
        elif "audit" in p_lower or "harden" in p_lower:
            subprocess.run(["chef", "audit"])
        elif "blue" in p_lower:
            subprocess.run(["chef", "blue"])
        else:
            self.execute_bash("uname -a && fastfetch || true")

def main():
    engine = ChefAIEngine()
    
    if len(sys.argv) > 1 and sys.argv[1] in ("login", "auth", "setup-key"):
        engine.prompt_login_if_needed()
        return

    if len(sys.argv) > 1 and sys.argv[1] not in ("-i", "--interactive"):
        prompt = " ".join(sys.argv[1:])
        engine.call_gemini(prompt)
    else:
        print(f"\n{C_CYAN}{C_BOLD}")
        print("  ╔═══════════════════════════════════════════════════════════════════════════╗")
        print("  ║                    🤖  CHEF_CARTHY AUTONOMOUS AI                          ║")
        print("  ║      Unrestricted System Controller · Cyber Suite · Machine Automation    ║")
        print("  ╚═══════════════════════════════════════════════════════════════════════════╝")
        print(f"{C_GRAY}  Powered by Google Gemini & Antigravity Engine · Full OS Access{C_RESET}\n")
        print(f"  {C_GRAY}• Give any command (e.g. 'install vlc', 'rotate wallpaper', 'scan 192.168.1.1'){C_RESET}")
        print(f"  {C_GRAY}• Google Authentication: {C_BOLD}chef ai login{C_RESET}")
        print(f"  {C_GRAY}• Type 'exit' to quit.\n{C_RESET}")

        if not engine.api_key:
            engine.prompt_login_if_needed()

        while True:
            try:
                user_prompt = input(f"{C_CYAN}{C_BOLD}chef-ai ❯ {C_RESET}").strip()
            except (KeyboardInterrupt, EOFError):
                print("\nExiting AI session.")
                break

            if not user_prompt:
                continue
            if user_prompt.lower() in ("exit", "quit", "q"):
                print("Goodbye!")
                break
            
            engine.call_gemini(user_prompt)
            print()

if __name__ == "__main__":
    main()
