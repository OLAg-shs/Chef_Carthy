#!/usr/bin/env python3
"""
Chef_Carthy OS - Autonomous Agentic AI Terminal Controller (chef-agent)
Integrates Google Gemini / Antigravity AI directly into the operating system.
Features:
- Parameter extraction & input validation (asks for missing targets before running)
- Tool calling: execute commands, read files, write configs, install packages
- Automated network recon & web application security auditing
- Full machine controller with local fallback
"""

import sys
import os
import re
import json
import time
import shutil
import subprocess
import urllib.request
import urllib.error
from pathlib import Path

# ANSI Styling
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_RED = "\033[38;5;196m"
C_GREEN = "\033[38;5;46m"
C_CYAN = "\033[38;5;51m"
C_YELLOW = "\033[38;5;226m"
C_PURPLE = "\033[38;5;141m"
C_GRAY = "\033[38;5;244m"

CONFIG_DIR = Path.home() / ".config" / "chef_carthy"
KEY_FILE = CONFIG_DIR / "ai_credentials.json"

SYSTEM_PROMPT = """You are the Chef_Carthy OS Autonomous System AI.
You have direct tool execution capabilities on the user's Arch Linux / Hyprland machine.
You can:
- Run bash commands to inspect the system, manage services, configure firewalls, and install software.
- Read, write, and create files, scripts, and development environments.
- Automate cybersecurity workflows, reconnaissance, auditing, and defensive tasks.

CRITICAL RULES:
1. Always validate parameters. If the user asks to scan a site or target but does not specify which site/IP/URL, do NOT run local machine diagnostics. Always ask the user for the target.
2. When a target is provided, use appropriate tools like `chef scan <target>` or `chef web <target>` or `nmap`."""

class ChefAIEngine:
    def __init__(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        self.api_key = self._load_api_key()

    def _load_api_key(self):
        env_key = os.getenv("GEMINI_API_KEY") or os.getenv("GOOGLE_API_KEY")
        if env_key:
            return env_key
        if KEY_FILE.exists():
            try:
                with open(KEY_FILE, "r") as f:
                    data = json.load(f)
                    return data.get("api_key")
            except Exception:
                pass
        return None

    def save_api_key(self, key):
        self.api_key = key.strip()
        with open(KEY_FILE, "w") as f:
            json.dump({"api_key": self.api_key}, f, indent=2)
        print(f"{C_GREEN}{C_BOLD}✓ Google AI / Gemini API Key saved successfully to ~/.config/chef_carthy/ai_credentials.json{C_RESET}")

    def execute_bash(self, command: str) -> dict:
        print(f"  {C_PURPLE}⚙️ [AI EXEC]{C_RESET} {C_BOLD}{command}{C_RESET}")
        try:
            res = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=60)
            return {"stdout": res.stdout.strip(), "stderr": res.stderr.strip(), "exit_code": res.returncode}
        except Exception as e:
            return {"error": str(e)}

    def read_file(self, path: str) -> dict:
        p = Path(path).expanduser()
        print(f"  {C_PURPLE}📖 [AI READ]{C_RESET} {C_BOLD}{p}{C_RESET}")
        if not p.exists():
            return {"error": f"File {p} does not exist"}
        try:
            with open(p, "r", encoding="utf-8", errors="replace") as f:
                return {"content": f.read()}
        except Exception as e:
            return {"error": str(e)}

    def write_file(self, path: str, content: str) -> dict:
        p = Path(path).expanduser()
        print(f"  {C_PURPLE}✍️ [AI WRITE]{C_RESET} {C_BOLD}{p}{C_RESET}")
        try:
            p.parent.mkdir(parents=True, exist_ok=True)
            with open(p, "w", encoding="utf-8") as f:
                f.write(content)
            return {"status": "success", "bytes_written": len(content)}
        except Exception as e:
            return {"error": str(e)}

    def validate_and_preprocess(self, prompt: str) -> str:
        """
        Extracts targets or prompts for missing arguments before running.
        """
        p_lower = prompt.lower().strip()

        # Check for scanning requests
        if any(term in p_lower for term in ["scan site", "scan this site", "scan website", "scan the site", "scan web", "scan url", "scan target"]):
            # Extract target domain/URL/IP
            words = prompt.split()
            potential_targets = []
            for w in words:
                cleaned = w.strip("<>'\"(),;")
                if re.match(r'^(https?://[^\s]+|([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}|(\d{1,3}\.){3}\d{1,3})$', cleaned):
                    potential_targets.append(cleaned)

            if potential_targets:
                target = potential_targets[0]
                print(f"  {C_CYAN}🎯 Target detected:{C_RESET} {C_BOLD}{target}{C_RESET}")
                return f"scan target {target}"
            else:
                print(f"\n{C_YELLOW}{C_BOLD}❓ Parameter Required:{C_RESET}")
                try:
                    target = input(f"{C_CYAN}{C_BOLD}Which site, domain, or IP would you like to scan? (e.g. example.com or 192.168.1.1): {C_RESET}").strip()
                except (KeyboardInterrupt, EOFError):
                    return ""
                
                if not target:
                    print(f"{C_GRAY}Scan cancelled (no target specified).{C_RESET}")
                    return ""
                return f"scan target {target}"

        return prompt

    def call_gemini(self, user_prompt: str):
        validated_prompt = self.validate_and_preprocess(user_prompt)
        if not validated_prompt:
            return

        if not self.api_key:
            return self._local_fallback(validated_prompt)

        url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={self.api_key}"
        
        tools_def = [
            {
                "function_declarations": [
                    {
                        "name": "execute_bash",
                        "description": "Execute a shell or bash command on the host Linux OS.",
                        "parameters": {
                            "type": "OBJECT",
                            "properties": {
                                "command": {"type": "STRING", "description": "The exact shell command to execute."}
                            },
                            "required": ["command"]
                        }
                    },
                    {
                        "name": "read_file",
                        "description": "Read the contents of any file on the local filesystem.",
                        "parameters": {
                            "type": "OBJECT",
                            "properties": {
                                "path": {"type": "STRING", "description": "The absolute or relative file path."}
                            },
                            "required": ["path"]
                        }
                    },
                    {
                        "name": "write_file",
                        "description": "Write or create a file on the local filesystem.",
                        "parameters": {
                            "type": "OBJECT",
                            "properties": {
                                "path": {"type": "STRING", "description": "The target file path."},
                                "content": {"type": "STRING", "description": "The exact content to write."}
                            },
                            "required": ["path", "content"]
                        }
                    }
                ]
            }
        ]

        contents = [{"role": "user", "parts": [{"text": f"{SYSTEM_PROMPT}\n\nTask: {validated_prompt}"}]}]
        
        for step in range(5):
            payload = {
                "contents": contents,
                "tools": tools_def
            }
            
            req = urllib.request.Request(
                url,
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json"}
            )
            
            try:
                with urllib.request.urlopen(req, timeout=30) as resp:
                    res_data = json.loads(resp.read().decode("utf-8"))
                    candidate = res_data.get("candidates", [{}])[0]
                    parts = candidate.get("content", {}).get("parts", [])
                    
                    tool_calls = [p.get("functionCall") for p in parts if "functionCall" in p]
                    text_parts = [p.get("text") for p in parts if "text" in p]

                    if text_parts:
                        for t in text_parts:
                            print(f"\n{C_CYAN}{C_BOLD}🤖 Chef AI:{C_RESET} {t}")

                    if not tool_calls:
                        break

                    for tc in tool_calls:
                        fn_name = tc.get("name")
                        fn_args = tc.get("args", {})
                        
                        tool_result = {}
                        if fn_name == "execute_bash":
                            tool_result = self.execute_bash(fn_args.get("command", ""))
                        elif fn_name == "read_file":
                            tool_result = self.read_file(fn_args.get("path", ""))
                        elif fn_name == "write_file":
                            tool_result = self.write_file(fn_args.get("path", ""), fn_args.get("content", ""))

                        contents.append({
                            "role": "model",
                            "parts": [{"functionCall": tc}]
                        })
                        contents.append({
                            "role": "function",
                            "parts": [{
                                "functionResponse": {
                                    "name": fn_name,
                                    "response": tool_result
                                }
                            }]
                        })
            except urllib.error.HTTPError as e:
                err_msg = e.read().decode("utf-8")
                print(f"{C_RED}API Error ({e.code}): {err_msg}{C_RESET}")
                break
            except Exception as e:
                print(f"{C_RED}Error: {e}{C_RESET}")
                break

    def _local_fallback(self, prompt: str):
        p_lower = prompt.lower().strip()
        
        # Scan target
        if "scan target" in p_lower:
            parts = prompt.split()
            target = parts[-1]
            if target.startswith("http://") or target.startswith("https://"):
                subprocess.run(["chef", "web", target])
            else:
                subprocess.run(["chef", "scan", target])
        elif "firewall" in p_lower or "ufw" in p_lower:
            self.execute_bash("sudo ufw status verbose")
        elif "port" in p_lower or "socket" in p_lower or "listeners" in p_lower:
            self.execute_bash("ss -tulpn")
        elif "audit" in p_lower or "hardening" in p_lower:
            self.execute_bash("chef audit")
        elif "blue" in p_lower:
            self.execute_bash("chef blue")
        else:
            self.execute_bash("uname -a && fastfetch || true")

def main():
    engine = ChefAIEngine()
    
    if len(sys.argv) > 1 and sys.argv[1] == "login":
        print(f"\n{C_PURPLE}{C_BOLD}🔑 CHEF_CARTHY AI - GOOGLE GEMINI AUTHENTICATION{C_RESET}\n")
        print(f"{C_GRAY}Get a free Gemini API key from: {C_BOLD}https://aistudio.google.com/{C_RESET}\n")
        try:
            key = input(f"{C_CYAN}{C_BOLD}Enter Gemini API Key: {C_RESET}").strip()
            if key:
                engine.save_api_key(key)
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
        return

    if len(sys.argv) > 1 and sys.argv[1] not in ("-i", "--interactive"):
        prompt = " ".join(sys.argv[1:])
        engine.call_gemini(prompt)
    else:
        print(f"\n{C_CYAN}{C_BOLD}")
        print("  ╔═══════════════════════════════════════════════════════════════════════════╗")
        print("  ║                    🤖  CHEF_CARTHY AUTONOMOUS AI                          ║")
        print("  ║         System Controller · Code Generator · Cyber Assistant              ║")
        print("  ╚═══════════════════════════════════════════════════════════════════════════╝")
        print(f"{C_GRAY}  Powered by Google Gemini / Antigravity Engine · Full Machine Access{C_RESET}\n")
        print(f"  {C_GRAY}• Type any request (e.g. 'scan example.com', 'harden firewall', 'create python script'){C_RESET}")
        print(f"  {C_GRAY}• To login with your Google API Key: {C_BOLD}chef ai login{C_RESET}")
        print(f"  {C_GRAY}• Type 'exit' to quit.\n{C_RESET}")

        while True:
            try:
                user_prompt = input(f"{C_CYAN}{C_BOLD}chef-ai ❯ {C_RESET}").strip()
            except (KeyboardInterrupt, EOFError):
                print("\nExiting AI session.")
                break

            if not user_prompt:
                continue
            if user_prompt.lower() in ("exit", "quit", "q"):
                print("Goodbye!")
                break
            
            engine.call_gemini(user_prompt)
            print()

if __name__ == "__main__":
    main()
