CONFIG_DIR = Path.home() / ".config" / "chef_carthy"
STATE_DIR = Path.home() / ".local" / "state" / "chef_carthy"

# Terminal Colors
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_RED = "\033[38;5;196m"
C_GREEN = "\033[38;5;46m"
C_CYAN = "\033[38;5;51m"
C_YELLOW = "\033[38;5;226m"
C_PURPLE = "\033[38;5;141m"
C_GRAY = "\033[38;5;244m"

BANNER = f"""{C_CYAN}{C_BOLD}
   ██████╗██╗  ██╗███████╗███████╗   ██████╗ █████╗ ██████╗ ████████╗██╗  ██╗██╗   ██╗
  ██╔════╝██║  ██║██╔════╝██╔════╝  ██╔════╝██╔══██╗██╔══██╗╚══██╔══╝██║  ██║╚██╗ ██╔╝
  ██║     ███████║█████╗  █████╗    ██║     ███████║██████╔╝   ██║   ███████║ ╚████╔╝ 
  ██║     ██╔══██║██╔══╝  ██╔══╝    ██║     ██╔══██║██╔══██╗   ██║   ██╔══██║  ╚██╔╝  
  ╚██████╗██║  ██║███████╗██║       ╚██████╗██║  ██║██║  ██║   ██║   ██║  ██║   ██║   
   ╚═════╝╚═╝  ╚═╝╚══════╝╚═╝        ╚═════╝╚═╝  ╚═╝╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝   ╚═╝   
{C_PURPLE}  ► Unrestricted AI · Tactical Cyber Workstation · Dynamic Wallpapers · v{VERSION}{C_RESET}
"""

def print_banner():
    print(BANNER)

def run_automated_scan(target):
    if not target:
        print(f"{C_RED}Error: Please specify a target IP, hostname, or subnet (e.g. chef scan 192.168.1.1){C_RESET}")
        return

    print(f"\n{C_PURPLE}{C_BOLD}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
    print(f"{C_CYAN}{C_BOLD}🔍 [CHEF RECON] AUTOMATED NETWORK & SERVICE SCANNER{C_RESET}")
    print(f"  {C_GRAY}Target:{C_RESET} {C_BOLD}{target}{C_RESET}")
    print(f"{C_PURPLE}═══════════════════════════════════════════════════════════════════════════════{C_RESET}\n")

    if shutil.which("nmap"):
        print(f"  {C_CYAN}Running Nmap SYN & Service Banner Detection...{C_RESET}")
        try:
            subprocess.run(["nmap", "-sV", "-T4", "-F", "--open", target])
        except Exception as e:
            print(f"  {C_RED}Nmap error: {e}{C_RESET}")
    else:
        print(f"  {C_GRAY}Nmap not found. Running built-in high-speed TCP socket scanner...{C_RESET}")
        common_ports = [21, 22, 23, 25, 53, 80, 110, 111, 135, 139, 143, 443, 445, 993, 995, 1433, 1521, 3306, 3389, 5432, 5900, 6379, 8000, 8080, 8443, 9000, 27017]
        open_ports = []
        for p in common_ports:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(0.3)
            result = s.connect_ex((target, p))
            if result == 0:
                service = "Unknown"
                try:
                    service = socket.getservbyport(p)
                except Exception:
                    pass
                open_ports.append((p, service))
            s.close()
        
        if open_ports:
            print(f"\n  {C_GREEN}{C_BOLD}OPEN PORTS DISCOVERED:{C_RESET}")
            for p, srv in open_ports:
                print(f"    {C_CYAN}• Port {p:<5}/tcp{C_RESET}  {C_BOLD}{srv}{C_RESET}")
        else:
            print(f"\n  {C_GRAY}No common open ports detected on target.{C_RESET}")
    print()

def run_web_audit(url):
    if not url:
        print(f"{C_RED}Error: Please specify a URL (e.g. chef web https://example.com){C_RESET}")
        return

    if not url.startswith("http://") and not url.startswith("https://"):
        url = "https://" + url

    print(f"\n{C_PURPLE}{C_BOLD}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
    print(f"{C_CYAN}{C_BOLD}🌐 [CHEF WEB] AUTOMATED WEB APPLICATION & API SECURITY AUDIT{C_RESET}")
    print(f"  {C_GRAY}URL:{C_RESET} {C_BOLD}{url}{C_RESET}")
    print(f"{C_PURPLE}═══════════════════════════════════════════════════════════════════════════════{C_RESET}\n")

    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Chef_Carthy-Security-Scanner/1.2"})
        with urllib.request.urlopen(req, timeout=5) as response:
            headers = dict(response.headers)
            status_code = response.getcode()
            
            print(f"  {C_BOLD}Status Code:{C_RESET} {C_GREEN if status_code == 200 else C_YELLOW}{status_code}{C_RESET}")
            server = headers.get("Server", "Hidden/Not Provided")
            print(f"  {C_BOLD}Server Header:{C_RESET} {C_CYAN}{server}{C_RESET}")

            # Security Headers Audit
            print(f"\n  {C_BOLD}Security Headers Evaluation:{C_RESET}")
            security_headers = [
                ("Strict-Transport-Security", "HSTS prevents SSL stripping"),
                ("Content-Security-Policy", "CSP mitigates XSS and data injection"),
                ("X-Frame-Options", "Prevents Clickjacking"),
                ("X-Content-Type-Options", "Prevents MIME-sniffing"),
                ("Referrer-Policy", "Controls referrer information leakage"),
                ("Permissions-Policy", "Restricts browser hardware APIs")
            ]

            score = 0
            for h_name, desc in security_headers:
                val = headers.get(h_name)
                if val:
                    score += 1
                    print(f"    {C_GREEN}✓ {h_name:<28}{C_RESET} {C_GRAY}{desc}{C_RESET}")
                else:
                    print(f"    {C_RED}✗ {h_name:<28}{C_RESET} {C_YELLOW}MISSING{C_RESET} {C_GRAY}({desc}){C_RESET}")
            
            score_pct = int((score / len(security_headers)) * 100)
            print(f"\n  {C_BOLD}Security Headers Hardening Score:{C_RESET} {C_GREEN if score_pct >= 80 else C_YELLOW if score_pct >= 50 else C_RED}{score_pct}%{C_RESET}\n")

    except Exception as e:
        print(f"  {C_RED}Failed to audit URL: {e}{C_RESET}\n")

def run_blue_team_audit():
    print(f"\n{C_PURPLE}{C_BOLD}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
    print(f"{C_CYAN}{C_BOLD}🛡️  [CHEF BLUE] BLUE TEAM HOST DEFENSE & ANOMALY INSPECTOR{C_RESET}")
    print(f"{C_PURPLE}═══════════════════════════════════════════════════════════════════════════════{C_RESET}\n")

    # 1. Active Network Sockets & Processes
    print(f"  {C_BOLD}1. Active Listening Sockets & Processes:{C_RESET}")
    try:
        out = subprocess.check_output(["ss", "-tulpn"], text=True)
        lines = out.strip().split("\n")[1:8]
        for l in lines:
            parts = l.split()
            if len(parts) >= 5:
                proto = parts[0]
                addr = parts[4]
                proc = parts[6] if len(parts) > 6 else "-"
                print(f"    {C_CYAN}{proto.upper():<4}{C_RESET} {addr:<22} {C_GRAY}Proc:{C_RESET} {C_BOLD}{proc}{C_RESET}")
    except Exception:
        print(f"    {C_GRAY}Unable to inspect sockets.{C_RESET}")

    # 2. Host Firewall Status
    print(f"\n  {C_BOLD}2. Defensive Shield (UFW / iptables):{C_RESET}")
    try:
        out = subprocess.check_output(["sudo", "-n", "ufw", "status"], stderr=subprocess.DEVNULL, text=True)
        if "active" in out.lower():
            print(f"    {C_GREEN}✓ UFW Firewall is ACTIVE{C_RESET}")
        else:
            print(f"    {C_YELLOW}⚠ UFW Firewall is INACTIVE. Enable with: sudo ufw enable{C_RESET}")
    except Exception:
        print(f"    {C_YELLOW}⚠ UFW Firewall status check requires sudo or is inactive.{C_RESET}")
    print()

def run_system_audit():
    print(f"\n{C_CYAN}{C_BOLD}🔍 [CHEF AUDIT] RUNNING HOST SECURITY POSTURE AUDIT...{C_RESET}\n")
    
    # 1. Kernel Parameters
    print(f"  {C_BOLD}1. Kernel Security Parameters (sysctl):{C_RESET}")
    sysctl_checks = {
        "kernel.kptr_restrict": "Hide kernel pointers",
        "kernel.dmesg_restrict": "Restrict unprivileged dmesg",
        "net.ipv4.tcp_syncookies": "SYN Flood Protection",
        "net.ipv4.icmp_echo_ignore_broadcasts": "Broadcast Ping Mitigation"
    }
    for key, desc in sysctl_checks.items():
        try:
            val = subprocess.check_output(["sysctl", "-n", key], text=True, stderr=subprocess.DEVNULL).strip()
            status = f"{C_GREEN}✓ Protected ({val}){C_RESET}" if val in ("1", "2") else f"{C_YELLOW}⚠ Value: {val}{C_RESET}"
            print(f"    {C_GRAY}• {desc:<30}{C_RESET} {status}")
        except Exception:
            pass

    print(f"\n{C_GREEN}{C_BOLD}✓ Host Audit Completed Successfully.{C_RESET}\n")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print_banner()
        print(f"{C_BOLD}USAGE:{C_RESET} chef <command> [args...]\n")
        print(f"  {C_CYAN}menu{C_RESET}                      Launch interactive control center dashboard")
        print(f"  {C_CYAN}ai <query> / agent{C_RESET}        Autonomous AI system controller (Google Gemini / unrestricted OS access)")
        print(f"  {C_CYAN}login / auth{C_RESET}              Authenticate Google Gemini API Key / Google CLI")
        print(f"  {C_CYAN}scan <target>{C_RESET}             Automated network discovery & port scan")
        print(f"  {C_CYAN}web <url>{C_RESET}                 Automated web application security audit")
        print(f"  {C_CYAN}blue{C_RESET}                      Blue-team host defense & listening sockets")
        print(f"  {C_CYAN}audit{C_RESET}                     Local host security posture & kernel audit")
        print(f"  {C_CYAN}pkg <subcommand>{C_RESET}          Universal package manager (VLC, VMware, pentest tools)")
        print(f"  {C_CYAN}install <pkg...>{C_RESET}          Install any software package via pacman/AUR")
        print(f"  {C_CYAN}theme <set/list>{C_RESET}          Switch tactical desktop themes & glowing borders")
        print(f"  {C_CYAN}wallpaper <command>{C_RESET}       Wallpaper rotator, interval setting, next/prev")
        print(f"  {C_CYAN}tutor / study{C_RESET}             Cybersecurity exam & certification academy")
        print(f"  {C_CYAN}update{C_RESET}                    Full system upgrade, AUR packages & maintenance")
        print(f"  {C_CYAN}version{C_RESET}                   Show suite version\n")
        return

    cmd = sys.argv[1].lower()

    if cmd == "menu":
        subprocess.run(["chef-menu"])
    elif cmd in ("scan", "recon"):
        target = sys.argv[2] if len(sys.argv) > 2 else ""
        run_automated_scan(target)
    elif cmd == "web":
        url = sys.argv[2] if len(sys.argv) > 2 else ""
        run_web_audit(url)
    elif cmd == "blue":
        run_blue_team_audit()
    elif cmd == "audit":
        run_system_audit()
    elif cmd in ("ai", "agent", "autopilot"):
        subprocess.run(["chef-agent"] + sys.argv[2:])
    elif cmd in ("login", "auth"):
        subprocess.run(["chef-agent", "login"])
    elif cmd == "pkg":
        subprocess.run(["chef-pkg"] + sys.argv[2:])
    elif cmd in ("install", "i", "add"):
        subprocess.run(["chef-pkg", "install"] + sys.argv[2:])
    elif cmd in ("app", "software"):
        subprocess.run(["chef-pkg", "app"] + sys.argv[2:])
    elif cmd in ("update", "upgrade"):
        subprocess.run(["chef-pkg", "update"])
    elif cmd == "theme":
        subprocess.run(["chef-theme"] + sys.argv[2:])
    elif cmd in ("wallpaper", "wall", "bg", "background"):
        subprocess.run(["chef-wallpaper"] + sys.argv[2:])
    elif cmd in ("tutor", "study"):
        subprocess.run(["chef-tutor"])
    elif cmd == "gui":
        subprocess.run(["chef-gui"])
    elif cmd == "version":
        print(f"Chef_Carthy OS Universal Suite v{VERSION}")
    else:
        print(f"{C_RED}Unknown command '{cmd}'. Run 'chef --help' for usage.{C_RESET}")

if __name__ == "__main__":
    main()
