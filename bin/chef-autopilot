#!/usr/bin/env python3
"""
Chef_Carthy OS - Autonomous AI Copilot & Automated Diagnostics Engine (chef-autopilot)
Allows users to describe a goal in plain English. The AI automatically:
1. Validates required parameters (e.g. target IP/domain for scanning).
2. Executes multi-step system, web, and network diagnostics.
3. Evaluates output and detects anomalies, open ports, and vulnerabilities.
4. Provides an executive risk assessment score and automated remediation.
"""

import sys
import os
import re
import json
import time
import shutil
import subprocess
from pathlib import Path

# ANSI Color Palette
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_CYAN = "\033[38;5;51m"
C_GREEN = "\033[38;5;46m"
C_YELLOW = "\033[38;5;226m"
C_RED = "\033[38;5;196m"
C_PURPLE = "\033[38;5;141m"
C_GRAY = "\033[38;5;244m"

class ChefAutopilot:
    def __init__(self):
        self.os_info = {
            "name": "Chef_Carthy OS",
            "kernel": subprocess.check_output(["uname", "-r"], text=True).strip(),
            "arch": subprocess.check_output(["uname", "-m"], text=True).strip(),
            "uptime": subprocess.check_output(["uptime", "-p"], text=True).strip() if shutil.which("uptime") else "Active"
        }

    def banner(self):
        print(f"{C_PURPLE}{C_BOLD}")
        print("   ██████╗██╗  ██╗███████╗███████╗   ██████╗ █████╗ ██████╗ ████████╗██╗  ██╗██╗   ██╗")
        print("  ██╔════╝██║  ██║██╔════╝██╔════╝  ██╔════╝██╔══██╗██╔══██╗╚══██╔══╝██║  ██║╚██╗ ██╔╝")
        print("  ██║     ███████║█████╗  █████╗    ██║     ███████║██████╔╝   ██║   ███████║ ╚████╔╝ ")
        print("  ██║     ██╔══██║██╔══╝  ██╔══╝    ██║     ██╔══██║██╔══██╗   ██║   ██╔══██║  ╚██╔╝  ")
        print("  ╚██████╗██║  ██║███████╗██║       ╚██████╗██║  ██║██║  ██║   ██║   ██║  ██║   ██║   ")
        print("   ╚═════╝╚═╝  ╚═╝╚══════╝╚═╝        ╚═════╝╚═╝  ╚═╝╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝   ╚═╝   ")
        print(f"{C_CYAN}  ► Autonomous AI Copilot & Intelligent Operations Engine{C_RESET}\n")

    def run_step(self, title: str, cmd: str) -> dict:
        print(f"  {C_PURPLE}⚡ [AI STEP]{C_RESET} {C_BOLD}{title}{C_RESET}")
        print(f"     {C_GRAY}Executing: {cmd}{C_RESET}")
        try:
            res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=20)
            status = f"{C_GREEN}✓ OK{C_RESET}" if res.returncode == 0 else f"{C_YELLOW}⚠ Code {res.returncode}{C_RESET}"
            print(f"     ↳ {status}")
            return {"cmd": cmd, "code": res.returncode, "stdout": res.stdout.strip(), "stderr": res.stderr.strip()}
        except Exception as e:
            print(f"     ↳ {C_RED}✗ Error: {e}{C_RESET}")
            return {"cmd": cmd, "code": -1, "error": str(e)}

    def execute_goal(self, goal: str):
        self.banner()
        goal_lower = goal.lower().strip()

        # Check if user asked to scan a site / target
        if any(term in goal_lower for term in ["scan site", "scan this site", "scan website", "scan the site", "scan web", "scan url", "scan target"]):
            # Extract target
            words = goal.split()
            potential_targets = []
            for w in words:
                cleaned = w.strip("<>'\"(),;")
                if re.match(r'^(https?://[^\s]+|([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}|(\d{1,3}\.){3}\d{1,3})$', cleaned):
                    potential_targets.append(cleaned)
            
            target = potential_targets[0] if potential_targets else None
            if not target:
                print(f"{C_YELLOW}{C_BOLD}❓ Target Required:{C_RESET}")
                try:
                    target = input(f"{C_CYAN}{C_BOLD}Which site, domain, or IP address would you like me to scan? (e.g. example.com or 192.168.1.1): {C_RESET}").strip()
                except (KeyboardInterrupt, EOFError):
                    print("\nAborted.")
                    return
                
                if not target:
                    print(f"{C_GRAY}Operation cancelled (no target specified).{C_RESET}")
                    return

            print(f"\n{C_CYAN}{C_BOLD}🎯 AUTONOMOUS GOAL:{C_RESET} {C_BOLD}\"Scan target: {target}\"{C_RESET}\n")
            if target.startswith("http://") or target.startswith("https://"):
                subprocess.run(["chef", "web", target])
            else:
                subprocess.run(["chef", "scan", target])
            return

        print(f"{C_CYAN}{C_BOLD}🎯 AUTONOMOUS GOAL:{C_RESET} {C_BOLD}\"{goal}\"{C_RESET}")
        print(f"{C_GRAY}System: {self.os_info['name']} · Kernel {self.os_info['kernel']} · {self.os_info['uptime']}{C_RESET}\n")
        print(f"{C_PURPLE}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
        print(f"{C_BOLD}1. DECOMPOSING GOAL INTO AUTOMATED DIAGNOSTIC ACTIONS...{C_RESET}\n")

        # Category A: Local Listening Sockets & Ports
        if any(w in goal_lower for w in ["open port", "socket", "listener", "listening"]):
            r1 = self.run_step("Scanning network interfaces & routing", "ip -brief address")
            r2 = self.run_step("Auditing listening TCP/UDP sockets (ss)", "ss -tuln")
            r3 = self.run_step("Verifying host firewall status", "sudo -n ufw status 2>/dev/null || echo 'inactive'")
            print(f"\n{C_GREEN}{C_BOLD}✓ Host network state mapped successfully.{C_RESET}\n")

        # Category B: System Security & Hardening Posture
        elif any(w in goal_lower for w in ["harden", "secure", "audit", "security", "protect", "defense"]):
            subprocess.run(["chef", "audit"])

        # Category C: Blue Team Defense
        elif "blue" in goal_lower:
            subprocess.run(["chef", "blue"])

        else:
            self.run_step("System telemetry inspection", "uname -a && fastfetch || true")

def main():
    copilot = ChefAutopilot()
    if len(sys.argv) > 1:
        goal = " ".join(sys.argv[1:])
        copilot.execute_goal(goal)
    else:
        copilot.banner()
        try:
            goal = input(f"{C_CYAN}{C_BOLD}Enter goal or instruction: {C_RESET}").strip()
            if goal:
                copilot.execute_goal(goal)
        except (KeyboardInterrupt, EOFError):
            print("\nExiting.")

if __name__ == "__main__":
    main()
