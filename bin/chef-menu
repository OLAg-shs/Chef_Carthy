#!/usr/bin/env python3
"""
Chef_Carthy OS - Interactive Cybersecurity Dashboard & TUI Control Center (chef-menu)
Omarchy-inspired clean terminal dashboard for automated pentesting, web audits,
blue team defense, and BlackArch toolchains.
"""

import sys
import os
import subprocess
import shutil

C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_CYAN = "\033[38;5;51m"
C_GREEN = "\033[38;5;46m"
C_PURPLE = "\033[38;5;141m"
C_YELLOW = "\033[38;5;226m"
C_GRAY = "\033[38;5;244m"

MENU_ITEMS = [
    ("1", "🔍 Automated Network Recon & Discovery", "scan"),
    ("2", "🌐 Automated Web Application & API Security Audit", "web"),
    ("3", "🛡️ Blue Team Host Defense & Listening Sockets", "chef blue"),
    ("4", "🔒 Local Host Hardening & Kernel Security Posture", "chef audit"),
    ("5", "📦 Install Cyber Toolchains (Recon, Web, Sniffing, Forensics)", "chef pkg bundles"),
    ("6", "🏴 Integrate BlackArch Repository (2,800+ Security Tools)", "chef pkg blackarch"),
    ("7", "🎨 Switch Tactical Desktop Theme", "chef theme list"),
    ("8", "⚡ Full System Upgrade & Package Maintenance", "chef pkg upgrade"),
    ("q", "❌ Exit Dashboard", None)
]

def run_tui_menu():
    while True:
        os.system("clear")
        print(f"{C_CYAN}{C_BOLD}")
        print("  ╔═══════════════════════════════════════════════════════════════════════════╗")
        print("  ║                   🛡️  CHEF_CARTHY CYBERSECURITY OS                        ║")
        print("  ║            Advanced Automated Pentesting & Blue Team Workstation          ║")
        print("  ╚═══════════════════════════════════════════════════════════════════════════╝")
        print(f"{C_GRAY}  Omarchy Engine · Arch Linux Wayland · High-Speed Cyber Suite{C_RESET}\n")

        for key, label, _ in MENU_ITEMS:
            print(f"  {C_BOLD}{C_CYAN}[{key}]{C_RESET} {label}")
        print()

        try:
            choice = input(f"{C_BOLD}Select an option (1-8, q): {C_RESET}").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print("\nExiting.")
            break

        if choice in ("q", "exit", "quit"):
            break

        matched = next((item for item in MENU_ITEMS if item[0] == choice), None)
        if matched:
            action = matched[2]
            if action == "scan":
                os.system("clear")
                target = input(f"{C_BOLD}{C_CYAN}Enter Target IP / Subnet (e.g. 127.0.0.1): {C_RESET}").strip()
                if target:
                    subprocess.run(["chef", "scan", target])
                input(f"\n{C_GRAY}Press Enter to return to menu...{C_RESET}")
            elif action == "web":
                os.system("clear")
                url = input(f"{C_BOLD}{C_CYAN}Enter Target URL (e.g. https://example.com): {C_RESET}").strip()
                if url:
                    subprocess.run(["chef", "web", url])
                input(f"\n{C_GRAY}Press Enter to return to menu...{C_RESET}")
            elif action:
                os.system("clear")
                subprocess.run(["bash", "-c", action])
                input(f"\n{C_GRAY}Press Enter to return to menu...{C_RESET}")
        else:
            print(f"{C_YELLOW}Invalid selection. Please choose 1-8 or q.{C_RESET}")

def main():
    run_tui_menu()

if __name__ == "__main__":
    main()
