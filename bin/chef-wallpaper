#!/usr/bin/env python3
"""
Chef_Carthy OS - Dynamic Wallpaper & Background Rotation Engine (chef-wallpaper)
Provides real-time wallpaper switching, automated background rotation daemon,
custom rotation duration/intervals, and synchronized theme aesthetics.
"""

import sys
import os
import time
import json
import random
import shutil
import signal
import subprocess
from pathlib import Path

# Directories
CONFIG_DIR = Path.home() / ".config" / "chef_carthy"
WALLPAPER_CONFIG = CONFIG_DIR / "wallpaper.json"
PID_FILE = CONFIG_DIR / "wallpaper_rotator.pid"

DEFAULT_WALLPAPER_DIRS = [
    Path.home() / ".config" / "chef_carthy" / "wallpapers",
    Path.home() / "Pictures" / "wallpapers",
    Path.home() / "Pictures" / "wallpaper",
    Path.home() / "Pictures",
    Path.home() / "Downloads" / "wallpapers",
    Path.home() / "Downloads",
    Path.home() / ".config" / "omarchy" / "themes",
    Path("/usr/share/backgrounds"),
    Path("/usr/share/hyprland")
]

# ANSI Styling
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_CYAN = "\033[38;5;51m"
C_GREEN = "\033[38;5;46m"
C_PURPLE = "\033[38;5;141m"
C_YELLOW = "\033[38;5;226m"
C_RED = "\033[38;5;196m"
C_GRAY = "\033[38;5;244m"

class ChefWallpaperManager:
    def __init__(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        self.config = self._load_config()

    def _load_config(self):
        default_config = {
            "enabled": True,
            "interval_seconds": 300,
            "mode": "sequential",  # sequential or random
            "current_wallpaper": "",
            "last_index": 0,
            "wallpaper_dirs": [str(d) for d in DEFAULT_WALLPAPER_DIRS]
        }
        if WALLPAPER_CONFIG.exists():
            try:
                with open(WALLPAPER_CONFIG, "r") as f:
                    data = json.load(f)
                    default_config.update(data)
            except Exception:
                pass
        return default_config

    def _save_config(self):
        with open(WALLPAPER_CONFIG, "w") as f:
            json.dump(self.config, f, indent=2)

    def scan_wallpapers(self):
        """Scans all configured directories for image files (.jpg, .png, .jpeg, .webp)."""
        valid_exts = {".jpg", ".jpeg", ".png", ".webp"}
        exclude_keywords = {"screenshot", "preview", "proof", "_check", "_view", "telemetry", "storage_cleaner", "single_bar", "step1_", "step2_", "step3_", "cooling_", "navbar", "compact"}
        found = []
        seen_names = set()
        
        # Check configured dirs
        for dir_path_str in self.config.get("wallpaper_dirs", []):
            dir_path = Path(dir_path_str).expanduser()
            if dir_path.exists() and dir_path.is_dir():
                try:
                    for root, _, files in os.walk(dir_path):
                        # If inside a theme directory, only pick from backgrounds folder
                        if "themes" in root and not root.endswith("backgrounds"):
                            continue
                        for file in files:
                            p = Path(root) / file
                            fname_lower = p.name.lower()
                            if p.suffix.lower() in valid_exts and not any(k in fname_lower for k in exclude_keywords):
                                if p.name not in seen_names:
                                    seen_names.add(p.name)
                                    found.append(p)
                except Exception:
                    pass

        # Sort for deterministic sequential cycling
        found.sort(key=lambda x: str(x.name).lower())
        return found

    def apply_wallpaper(self, wallpaper_path: Path):
        """Applies a wallpaper immediately to Hyprland / Wayland session."""
        if not wallpaper_path.exists():
            print(f"{C_RED}Error: Wallpaper file {wallpaper_path} does not exist.{C_RESET}")
            return False

        abs_path = str(wallpaper_path.resolve())
        print(f"  {C_CYAN}🖼️  Applying Wallpaper:{C_RESET} {C_BOLD}{wallpaper_path.name}{C_RESET}")
        print(f"     {C_GRAY}Path: {abs_path}{C_RESET}")

        # 1. Kill old swaybg if running and launch swaybg with new wallpaper
        try:
            subprocess.run(["pkill", "-x", "swaybg"], stderr=subprocess.DEVNULL)
            time.sleep(0.1)
            subprocess.Popen(["swaybg", "-i", abs_path, "-m", "fill"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

        # 2. Try hyprctl / hyprpaper if available
        if shutil.which("hyprctl"):
            try:
                subprocess.run(["hyprctl", "hyprpaper", "preload", abs_path], stderr=subprocess.DEVNULL)
                subprocess.run(["hyprctl", "hyprpaper", "wallpaper", f",{abs_path}"], stderr=subprocess.DEVNULL)
            except Exception:
                pass

        # 3. Update omarchy rotator / walltheme state if present
        omarchy_rotator = Path.home() / ".config" / "omarchy" / "rotator.json"
        if omarchy_rotator.exists():
            try:
                with open(omarchy_rotator, "r") as f:
                    or_data = json.load(f)
                or_data["current_wallpaper"] = abs_path
                with open(omarchy_rotator, "w") as f:
                    json.dump(or_data, f, indent=2)
            except Exception:
                pass

        # 4. Save state
        self.config["current_wallpaper"] = abs_path
        self._save_config()

        # 5. Desktop Notification
        if shutil.which("notify-send"):
            try:
                subprocess.run([
                    "notify-send", "-a", "Chef_Carthy OS", "-i", "preferences-desktop-wallpaper",
                    "Wallpaper Updated", f"Now active: {wallpaper_path.name}"
                ], stderr=subprocess.DEVNULL)
            except Exception:
                pass

        print(f"  {C_GREEN}{C_BOLD}✓ Wallpaper active!{C_RESET}")
        return True

    def next_wallpaper(self):
        wallpapers = self.scan_wallpapers()
        if not wallpapers:
            print(f"{C_YELLOW}No wallpapers found in configured directories!{C_RESET}")
            print(f"{C_GRAY}Place .jpg / .png images in ~/Downloads/wallpapers or ~/Pictures{C_RESET}")
            return

        mode = self.config.get("mode", "sequential")
        current = self.config.get("current_wallpaper", "")
        
        next_idx = 0
        if mode == "random":
            next_idx = random.randint(0, len(wallpapers) - 1)
        else:
            try:
                cur_p = Path(current)
                if cur_p in wallpapers:
                    next_idx = (wallpapers.index(cur_p) + 1) % len(wallpapers)
                else:
                    next_idx = (self.config.get("last_index", 0) + 1) % len(wallpapers)
            except Exception:
                next_idx = 0

        self.config["last_index"] = next_idx
        self._save_config()
        self.apply_wallpaper(wallpapers[next_idx])

    def prev_wallpaper(self):
        wallpapers = self.scan_wallpapers()
        if not wallpapers:
            print(f"{C_YELLOW}No wallpapers found!{C_RESET}")
            return

        current = self.config.get("current_wallpaper", "")
        try:
            cur_p = Path(current)
            if cur_p in wallpapers:
                prev_idx = (wallpapers.index(cur_p) - 1) % len(wallpapers)
            else:
                prev_idx = (self.config.get("last_index", 0) - 1) % len(wallpapers)
        except Exception:
            prev_idx = 0

        self.config["last_index"] = prev_idx
        self._save_config()
        self.apply_wallpaper(wallpapers[prev_idx])

    def set_interval(self, duration_str: str):
        """Parses duration string like 30s, 5m, 15m, 1h, 300 into seconds."""
        duration_str = duration_str.strip().lower()
        seconds = 300
        
        if duration_str.endswith("s"):
            seconds = int(duration_str[:-1])
        elif duration_str.endswith("m"):
            seconds = int(duration_str[:-1]) * 60
        elif duration_str.endswith("h"):
            seconds = int(duration_str[:-1]) * 3600
        elif duration_str.isdigit():
            seconds = int(duration_str)
        else:
            print(f"{C_RED}Invalid duration format: '{duration_str}'. Use e.g. '30s', '5m', '15m', '1h', or '300'.{C_RESET}")
            return

        if seconds < 5:
            seconds = 5

        self.config["interval_seconds"] = seconds
        self._save_config()

        # Update omarchy rotator too
        omarchy_rotator = Path.home() / ".config" / "omarchy" / "rotator.json"
        if omarchy_rotator.exists():
            try:
                with open(omarchy_rotator, "r") as f:
                    or_data = json.load(f)
                or_data["interval_seconds"] = seconds
                with open(omarchy_rotator, "w") as f:
                    json.dump(or_data, f, indent=2)
            except Exception:
                pass

        mins = seconds / 60
        print(f"{C_GREEN}{C_BOLD}✓ Wallpaper rotation duration set to {seconds} seconds ({mins:.1f} minutes).{C_RESET}")

    def list_wallpapers(self):
        wallpapers = self.scan_wallpapers()
        current = self.config.get("current_wallpaper", "")

        print(f"\n{C_PURPLE}{C_BOLD}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
        print(f"{C_CYAN}{C_BOLD}🖼️  CHEF_CARTHY OS - WALLPAPER CATALOG & ROTATOR{C_RESET}")
        print(f"{C_PURPLE}═══════════════════════════════════════════════════════════════════════════════{C_RESET}\n")
        print(f"  {C_GRAY}Rotation Interval:{C_RESET} {C_BOLD}{self.config.get('interval_seconds', 300)} seconds{C_RESET} ({self.config.get('interval_seconds', 300)/60:.1f} min)")
        print(f"  {C_GRAY}Rotation Mode:{C_RESET}     {C_BOLD}{self.config.get('mode', 'sequential').upper()}{C_RESET}")
        print(f"  {C_GRAY}Total Discovered:{C_RESET}  {C_BOLD}{len(wallpapers)} wallpapers{C_RESET}\n")

        if not wallpapers:
            print(f"  {C_YELLOW}No wallpapers found in scanned directories.{C_RESET}")
            print(f"  {C_GRAY}Add your images to ~/Downloads/wallpapers or ~/Pictures{C_RESET}\n")
            return

        for idx, w in enumerate(wallpapers, 1):
            is_active = str(w.resolve()) == current
            prefix = f"{C_GREEN}{C_BOLD}► [ACTIVE]{C_RESET}" if is_active else f"{C_CYAN}[{idx:02d}]{C_RESET}"
            print(f"  {prefix} {w.name}  {C_GRAY}({w.parent}){C_RESET}")
        print()

    def start_daemon(self):
        """Starts background rotation daemon."""
        if PID_FILE.exists():
            try:
                pid = int(PID_FILE.read_text().strip())
                os.kill(pid, 0)
                print(f"{C_YELLOW}Wallpaper rotator daemon is already running (PID: {pid}).{C_RESET}")
                return
            except (ProcessLookupError, ValueError):
                PID_FILE.unlink(missing_ok=True)

        print(f"{C_CYAN}{C_BOLD}⚡ Starting Chef Wallpaper Rotation Daemon...{C_RESET}")
        interval = self.config.get("interval_seconds", 300)
        print(f"  {C_GRAY}Interval:{C_RESET} {C_BOLD}{interval} seconds{C_RESET}")

        # Spawn background process
        cmd = [sys.executable, str(Path(__file__).resolve()), "run-loop"]
        proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        PID_FILE.write_text(str(proc.pid))
        print(f"{C_GREEN}{C_BOLD}✓ Rotator daemon started in background (PID: {proc.pid}){C_RESET}\n")

    def stop_daemon(self):
        if not PID_FILE.exists():
            print(f"{C_GRAY}Wallpaper rotator daemon is not running.{C_RESET}")
            return

        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, signal.SIGTERM)
            print(f"{C_GREEN}{C_BOLD}✓ Wallpaper rotator daemon stopped (PID: {pid}).{C_RESET}")
        except Exception as e:
            print(f"{C_GRAY}Stopped daemon ({e}).{C_RESET}")
        finally:
            PID_FILE.unlink(missing_ok=True)

    def run_loop(self):
        """Internal daemon loop."""
        while True:
            self.config = self._load_config()
            interval = self.config.get("interval_seconds", 300)
            self.next_wallpaper()
            time.sleep(interval)

def main():
    mgr = ChefWallpaperManager()

    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(f"\n{C_BOLD}Chef_Carthy OS Wallpaper & Background Manager (chef-wallpaper){C_RESET}")
        print(f"\n{C_BOLD}USAGE:{C_RESET} chef wallpaper <command> [args...]\n")
        print(f"  {C_CYAN}next{C_RESET}                   Switch to next wallpaper immediately")
        print(f"  {C_CYAN}prev{C_RESET}                   Switch to previous wallpaper")
        print(f"  {C_CYAN}random{C_RESET}                 Pick a random wallpaper")
        print(f"  {C_CYAN}set <path/name>{C_RESET}        Apply a specific image as active wallpaper")
        print(f"  {C_CYAN}interval <duration>{C_RESET}    Set rotation interval (e.g. 5m, 15m, 30m, 1h, 300s)")
        print(f"  {C_CYAN}list{C_RESET}                   List all available wallpapers and current status")
        print(f"  {C_CYAN}start{C_RESET}                  Start the automatic background rotator daemon")
        print(f"  {C_CYAN}stop{C_RESET}                   Stop the automatic rotator daemon")
        print(f"  {C_CYAN}status{C_RESET}                 Check status of rotator daemon and active wallpaper\n")
        return

    cmd = sys.argv[1].lower()

    if cmd == "next":
        mgr.next_wallpaper()
    elif cmd in ("prev", "previous"):
        mgr.prev_wallpaper()
    elif cmd == "random":
        mgr.config["mode"] = "random"
        mgr.next_wallpaper()
    elif cmd == "set":
        if len(sys.argv) > 2:
            target = sys.argv[2]
            p = Path(target).expanduser()
            if not p.exists():
                # Search by filename
                for w in mgr.scan_wallpapers():
                    if target.lower() in w.name.lower():
                        p = w
                        break
            mgr.apply_wallpaper(p)
        else:
            print(f"{C_YELLOW}Please specify a wallpaper filename or path.{C_RESET}")
    elif cmd in ("interval", "duration", "time"):
        if len(sys.argv) > 2:
            mgr.set_interval(sys.argv[2])
        else:
            print(f"{C_YELLOW}Please specify a duration (e.g. chef wallpaper interval 5m){C_RESET}")
    elif cmd in ("list", "ls"):
        mgr.list_wallpapers()
    elif cmd == "start":
        mgr.start_daemon()
    elif cmd == "stop":
        mgr.stop_daemon()
    elif cmd == "status":
        is_running = False
        pid = None
        if PID_FILE.exists():
            try:
                pid = int(PID_FILE.read_text().strip())
                os.kill(pid, 0)
                is_running = True
            except Exception:
                PID_FILE.unlink(missing_ok=True)
        
        status_str = f"{C_GREEN}RUNNING (PID: {pid}){C_RESET}" if is_running else f"{C_GRAY}STOPPED{C_RESET}"
        print(f"\n{C_CYAN}{C_BOLD}🖼️  CHEF WALLPAPER ROTATOR STATUS{C_RESET}")
        print(f"  Daemon State:      {status_str}")
        print(f"  Interval:          {C_BOLD}{mgr.config.get('interval_seconds', 300)} seconds{C_RESET}")
        print(f"  Active Wallpaper:  {C_BOLD}{mgr.config.get('current_wallpaper', 'None')}{C_RESET}\n")
    elif cmd == "run-loop":
        mgr.run_loop()
    else:
        print(f"{C_RED}Unknown command '{cmd}'. Run 'chef wallpaper --help' for usage.{C_RESET}")

if __name__ == "__main__":
    main()
