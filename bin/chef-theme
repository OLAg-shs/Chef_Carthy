def list_themes():
    print(f"\n{C_PURPLE}{C_BOLD}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
    print(f"{C_CYAN}{C_BOLD}🎨 CHEF_CARTHY OS - TACTICAL THEME CATALOG{C_RESET}")
    print(f"{C_PURPLE}═══════════════════════════════════════════════════════════════════════════════{C_RESET}\n")

    for t_id, t in THEMES.items():
        print(f"  {C_BOLD}{C_CYAN}► {t['name']}{C_RESET} [{C_PURPLE}{t_id}{C_RESET}]")
        print(f"    {t['description']}")
        print(f"    Accent: {t['accent']} | Secondary: {t['accent_secondary']}")
        print()
    print(f"{C_GRAY}Apply a theme with: {C_BOLD}chef theme set <theme-name>{C_RESET}")
    print(f"{C_GRAY}Set custom colors:  {C_BOLD}chef theme custom <accent_hex> [secondary_hex]{C_RESET}")
    print(f"{C_GRAY}Wallpaper rotator:  {C_BOLD}chef wallpaper next / interval <5m>{C_RESET}\n")

def hex_to_rgb(hex_code):
    hex_code = hex_code.lstrip("#")
    if len(hex_code) == 6:
        return tuple(int(hex_code[i:i+2], 16) for i in (0, 2, 4))
    return (88, 166, 255)

def apply_theme(theme_id, custom_accent=None, custom_sec=None):
    if custom_accent:
        t = {
            "name": f"Custom ({custom_accent})",
            "accent": custom_accent,
            "accent_secondary": custom_sec or custom_accent,
            "background": "#0b0e14",
            "foreground": "#f3f4f6",
            "border_active": f"rgb({hex_to_rgb(custom_accent)[0]},{hex_to_rgb(custom_accent)[1]},{hex_to_rgb(custom_accent)[2]}) 45deg",
            "border_inactive": "rgb(30,36,50)"
        }
    elif theme_id in THEMES:
        t = THEMES[theme_id]
    else:
        print(f"{C_RED}Error: Unknown theme '{theme_id}'. Run 'chef theme list' to see options.{C_RESET}")
        return

    print(f"\n{C_CYAN}{C_BOLD}🎨 Applying Theme: {t['name']}...{C_RESET}")

    # 1. Update Hyprland border config
    hypr_theme_file = Path.home() / ".config" / "hypr" / "theme.conf"
    hypr_theme_file.parent.mkdir(parents=True, exist_ok=True)
    with open(hypr_theme_file, "w") as f:
        f.write(f"""# Chef_Carthy Theme: {t['name']}
general {{
    col.active_border = {t['border_active']}
    col.inactive_border = {t['border_inactive']}
}}
""")
    print(f"  {C_GREEN}✓ Updated Hyprland glowing borders{C_RESET}")

    # 2. Reload Hyprland
    try:
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"  {C_GREEN}✓ Reloaded Hyprland configuration{C_RESET}")
    except Exception:
        pass

    # 3. Synchronize with Omarchy themes if applicable
    omarchy_themes = Path.home() / ".config" / "omarchy" / "themes"
    if omarchy_themes.exists() and theme_id in [d.name for d in omarchy_themes.iterdir() if d.is_dir()]:
        try:
            subprocess.run(["omarchy", "theme", "set", theme_id], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    # 4. Notify
    try:
        subprocess.run([
            "notify-send", "-a", "Chef_Carthy OS", "-i", "preferences-desktop-theme",
            "Theme Applied", f"Active Theme: {t['name']}"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    print(f"\n{C_GREEN}{C_BOLD}✓ Theme '{t['name']}' is now ACTIVE!{C_RESET}\n")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help", "list"):
        list_themes()
        return

    cmd = sys.argv[1]
    if cmd == "set":
        if len(sys.argv) > 2:
            apply_theme(sys.argv[2])
        else:
            list_themes()
    elif cmd == "custom":
        if len(sys.argv) > 2:
            accent = sys.argv[2]
            sec = sys.argv[3] if len(sys.argv) > 3 else None
            apply_theme("custom", custom_accent=accent, custom_sec=sec)
        else:
            print(f"{C_YELLOW}Usage: chef theme custom <accent_hex> [secondary_hex]{C_RESET}")
    elif cmd in ("wallpaper", "wall", "bg", "background"):
        # Forward directly to chef-wallpaper
        script_dir = Path(__file__).resolve().parent
        wall_bin = script_dir / "chef-wallpaper"
        if wall_bin.exists():
            subprocess.run([str(wall_bin)] + sys.argv[2:])
        else:
            subprocess.run(["chef-wallpaper"] + sys.argv[2:])
    else:
        apply_theme(cmd)

if __name__ == "__main__":
    main()
