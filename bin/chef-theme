#!/usr/bin/env python3
"""
Chef_Carthy OS - Tactical Theme & Aesthetics Engine (chef-theme)
Applies synchronized colors, wallpapers, terminal palettes, and Hyprland glow
with instant hot-reloading, custom accent generation, and wallpaper rotator integration.
"""

import sys
import os
import json
import shutil
import subprocess
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "chef_carthy"
THEMES_DIR = CONFIG_DIR / "themes"

C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_CYAN = "\033[38;5;51m"
C_GREEN = "\033[38;5;46m"
C_PURPLE = "\033[38;5;141m"
C_YELLOW = "\033[38;5;226m"
C_RED = "\033[38;5;196m"
C_GRAY = "\033[38;5;244m"

THEMES = {
    "cyber-cyan": {
        "name": "Neon Cyber Cyan",
