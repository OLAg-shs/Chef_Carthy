#!/usr/bin/env python3
"""
Chef_Carthy OS - Interactive Cybersecurity Tutor & Certification Assistant (chef-tutor)
Provides an interactive educational tutor for security fundamentals, networking,
cryptography, Linux internals, OWASP Top 10, and exam preparation (Security+, CEH, OSCP concepts).
"""

import sys
import os
import json
import time

# Terminal Colors
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_CYAN = "\033[38;5;51m"
C_GREEN = "\033[38;5;46m"
C_YELLOW = "\033[38;5;226m"
C_RED = "\033[38;5;196m"
C_PURPLE = "\033[38;5;141m"
C_GRAY = "\033[38;5;244m"

TOPICS = {
    "1": {
        "title": "Network Protocols & Traffic Analysis",
        "description": "TCP 3-way handshake, Subnetting, OSI Model, DNS, TLS/SSL, Wireshark filters",
        "content": """
[📡 Network Fundamentals & Packet Analysis]
• OSI Model Layers:
  1. Physical (Cables, Bits)
  2. Data Link (Ethernet frames, MAC addresses, ARP)
  3. Network (IP packets, ICMP, Routing)
  4. Transport (TCP 3-way handshake SYN->SYN/ACK->ACK, UDP datagrams)
  5. Session (Sockets, RPC)
  6. Presentation (SSL/TLS encryption, encoding)
  7. Application (HTTP, DNS, SSH, FTP)

• Essential Wireshark Filter Syntax:
  - 'http.request.method == "POST"' -> Isolate POST submissions
  - 'ip.addr == 192.168.1.1'         -> Filter specific host traffic
  - 'tcp.flags.syn == 1 && tcp.flags.ack == 0' -> Spot TCP SYN connection attempts
  - 'dns.flags.response == 0'       -> Find outgoing DNS queries
"""
    },
    "2": {
        "title": "Web Security & OWASP Top 10",
        "description": "SQL Injection mitigation, XSS defenses, CSRF tokens, Access Control, SSRF",
        "content": """
[🌐 Web Security & OWASP Defenses]
1. Injection (SQLi, Command Injection):
   • Vulnerability: Concatenating untrusted user input directly into queries.
   • Defensive Fix: Always use Parameterized Queries / Prepared Statements (e.g. PDO, ORMs).

2. Broken Authentication & Session Management:
   • Best Practice: Secure cookies with 'HttpOnly', 'Secure', and 'SameSite=Strict' flags.
   • Use strong password hashing: Argon2id or bcrypt with appropriate work factor.

3. Cross-Site Scripting (XSS):
   • Stored vs Reflected vs DOM-based.
   • Defensive Fix: Context-aware output encoding & Content Security Policy (CSP) headers.

4. Server-Side Request Forgery (SSRF):
   • Defense: Whitelist destination hostnames/IPs and disable internal loopback/cloud metadata access (169.254.169.254).
"""
    },
    "3": {
        "title": "Linux Hardening & System Internals",
        "description": "File permissions, SUID/SGID auditing, kernel parameters, PAM & auditd",
        "content": """
[🐧 Linux Internals & Hardening Architecture]
• File Permissions & SUID Bits:
  - 4755 (-rwsr-xr-x): SUID bit executes binary with owner (root) privileges.
  - Audit command: 'find / -perm -4000 -type f 2>/dev/null'

• Linux Kernel Self-Protection (sysctl):
  - 'kernel.dmesg_restrict = 1' -> Prevents unprivileged users from reading kernel ring buffer.
  - 'kernel.kptr_restrict = 2'  -> Hides real kernel symbol memory addresses.
  - 'net.ipv4.tcp_syncookies = 1' -> Defends against TCP SYN flood denial-of-service.

• Service Isolation:
  - Systemd sandboxing: ProtectSystem=strict, ProtectHome=yes, NoNewPrivileges=true.
"""
    },
    "4": {
        "title": "Cryptography & Authentication",
        "description": "Symmetric vs Asymmetric, RSA, ECC, AES-GCM, Hash functions & Digital Signatures",
        "content": """
[🔐 Cryptography & Key Management]
• Symmetric Encryption (Shared Secret):
  - Standard: AES-256-GCM (Authenticated Encryption providing confidentiality + integrity).
  - ChaCha20-Poly1305: High-speed mobile/embedded cipher.

• Asymmetric Encryption (Public / Private Key Pairs):
  - RSA (2048+ bit), ECC (Elliptic Curve: Ed25519, Curve25519).
  - Use cases: Key exchange (ECDH), digital signatures, SSH authentication.

• Cryptographic Hashing:
  - Data Integrity: SHA-256, SHA-3.
  - Password Storage: Argon2id, PBKDF2, bcrypt (NEVER use MD5 or SHA-1).
"""
    },
    "5": {
        "title": "Security Assessment & Auditing Methodology",
        "description": "PTES Framework, Scope of Work, Passive Recon, Vulnerability Scanning & Reporting",
        "content": """
[🎯 Penetration Testing Execution Standard (PTES)]
1. Pre-engagement Interactions:
   • Rules of Engagement (RoE), Scope definition, Legal Authorization & NDA.
2. Intelligence Gathering:
   • Passive OSINT (WHOIS, DNS records, public metadata) vs Active Recon.
3. Threat Modeling & Vulnerability Analysis:
   • Identifying system architectural flaws and unpatched CVEs.
4. Reporting & Remediation Roadmaps:
   • Executive Summary + Technical Risk Matrix (CVSS scoring) + Detailed remediation steps.
"""
    }
}

def show_tutor_menu():
    print(f"\n{C_PURPLE}{C_BOLD}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
    print(f"{C_CYAN}{C_BOLD}🎓 CHEF_CARTHY OS — CYBERSECURITY TUTOR & EXAM STUDY ACADEMY{C_RESET}")
    print(f"{C_PURPLE}═══════════════════════════════════════════════════════════════════════════════{C_RESET}\n")
    print(f"{C_GRAY}Comprehensive study modules for Security+, CEH, and Cybersecurity Exams:{C_RESET}\n")

    for key, topic in TOPICS.items():
        print(f"  {C_BOLD}{C_CYAN}[{key}]{C_RESET} {C_BOLD}{topic['title']}{C_RESET}")
        print(f"      {C_GRAY}{topic['description']}{C_RESET}")

    print(f"  {C_BOLD}{C_CYAN}[q]{C_RESET} Exit Tutor\n")

def run_interactive_tutor():
    while True:
        show_tutor_menu()
        try:
            choice = input(f"{C_BOLD}Select a study module (1-5, q): {C_RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nExiting study tutor.")
            break

        if choice in ("q", "quit", "exit"):
            break

        if choice in TOPICS:
            topic = TOPICS[choice]
            os.system("clear")
            print(f"{C_PURPLE}{C_BOLD}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
            print(f"{C_CYAN}{C_BOLD}📚 Module {choice}: {topic['title']}{C_RESET}")
            print(f"{C_PURPLE}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
            print(topic["content"])
            print(f"{C_PURPLE}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
            input(f"\n{C_GRAY}Press Enter to return to topic menu...{C_RESET}")
        else:
            print(f"{C_YELLOW}Invalid choice. Select 1-5 or q.{C_RESET}")

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("--help", "-h"):
        print("Usage: chef tutor (or chef study)")
        return
    run_interactive_tutor()

if __name__ == "__main__":
    main()
