#!/usr/bin/env python3
"""
Chef_Carthy OS - Tactical Theme & Aesthetics Engine (chef-theme)
Applies synchronized colors, wallpapers, terminal palettes, and Hyprland glow
with instant hot-reloading and zero system overhead.
"""

import sys
import os
import json
import shutil
import subprocess
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "chef_carthy"
THEMES_DIR = Path.home() / ".config" / "chef_carthy" / "themes"

C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_CYAN = "\033[38;5;51m"
C_GREEN = "\033[38;5;46m"
C_PURPLE = "\033[38;5;141m"
C_YELLOW = "\033[38;5;226m"
C_GRAY = "\033[38;5;244m"

THEMES = {
    "cyber-cyan": {
        "name": "Neon Cyber Cyan",
        "description": "Tactical black, electric cyan accents, and glowing cyan borders",
        "accent": "#00f0ff",
        "accent_secondary": "#7000ff",
        "background": "#0b0e14",
        "foreground": "#e6edf3",
        "border_active": "rgb(00f0ff) rgb(7000ff) 45deg",
        "border_inactive": "rgb(1f293d)"
    },
    "matrix-green": {
        "name": "Emerald Matrix",
        "description": "High-contrast emerald phosphor & terminal cyber matrix",
        "accent": "#00ff66",
        "accent_secondary": "#008f11",
        "background": "#050d08",
        "foreground": "#d1fae5",
        "border_active": "rgb(00ff66) rgb(008f11) 45deg",
        "border_inactive": "rgb(143820)"
    },
    "synth-amber": {
        "name": "Amber Tactical",
        "description": "Retro amber phosphor HUD, titanium dark gray & high visibility",
        "accent": "#ffb000",
        "accent_secondary": "#ff5500",
        "background": "#120e0a",
        "foreground": "#fef3c7",
        "border_active": "rgb(ffb000) rgb(ff5500) 45deg",
        "border_inactive": "rgb(3d2914)"
    },
    "violet-night": {
        "name": "Electric Violet",
        "description": "Vibrant purple neon with midnight obsidian glassmorphism",
        "accent": "#a855f7",
        "accent_secondary": "#ec4899",
        "background": "#0d0b14",
        "foreground": "#f3e8ff",
        "border_active": "rgb(a855f7) rgb(ec4899) 45deg",
        "border_inactive": "rgb(2d1b4e)"
    }
}

def list_themes():
    print(f"\n{C_PURPLE}{C_BOLD}═══════════════════════════════════════════════════════════════════════════════{C_RESET}")
    print(f"{C_CYAN}{C_BOLD}🎨 CHEF_CARTHY OS - TACTICAL THEME CATALOG{C_RESET}")
    print(f"{C_PURPLE}═══════════════════════════════════════════════════════════════════════════════{C_RESET}\n")

    for t_id, t in THEMES.items():
        print(f"  {C_BOLD}{C_CYAN}► {t['name']}{C_RESET} [{C_PURPLE}{t_id}{C_RESET}]")
        print(f"    {t['description']}")
        print(f"    Accent: {t['accent']} | Secondary: {t['accent_secondary']}")
        print()
    print(f"{C_GRAY}Apply a theme with: {C_BOLD}chef theme set <theme-name>{C_RESET}\n")

def apply_theme(theme_id):
    if theme_id not in THEMES:
        print(f"Error: Unknown theme '{theme_id}'. Run 'chef theme list' to see options.")
        return

    t = THEMES[theme_id]
    print(f"\n{C_CYAN}{C_BOLD}🎨 Applying Theme: {t['name']}...{C_RESET}")

    # 1. Update Hyprland border config
    hypr_theme_file = Path.home() / ".config" / "hypr" / "theme.conf"
    hypr_theme_file.parent.mkdir(parents=True, exist_ok=True)
    with open(hypr_theme_file, "w") as f:
        f.write(f"""# Chef_Carthy Theme: {t['name']}
general {{
    col.active_border = {t['border_active']}
    col.inactive_border = {t['border_inactive']}
}}
""")
    print(f"  {C_GREEN}✓ Updated Hyprland border colors{C_RESET}")

    # 2. Reload Hyprland
    try:
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"  {C_GREEN}✓ Reloaded Hyprland configuration{C_RESET}")
    except Exception:
        pass

    # 3. Notify
    try:
        subprocess.run([
            "omarchy", "notification", "send",
            "-g", "🎨",
            "-u", "low",
            "Theme Applied",
            f"Chef_Carthy OS Theme set to '{t['name']}'."
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    print(f"\n{C_GREEN}{C_BOLD}✓ Theme '{t['name']}' is now ACTIVE!{C_RESET}\n")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help", "list"):
        list_themes()
        return

    cmd = sys.argv[1]
    if cmd == "set":
        if len(sys.argv) > 2:
            apply_theme(sys.argv[2])
        else:
            list_themes()
    else:
        apply_theme(cmd)

if __name__ == "__main__":
    main()
