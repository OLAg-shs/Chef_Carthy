[Unit]
Description=Show "Chef OS" text on the Plymouth boot splash
DefaultDependencies=no
After=plymouth-start.service
Before=multi-user.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/bin/plymouth display-message --text="Chef OS"
RemainAfterExit=yes

[Install]
WantedBy=initrd.target sysinit.target
